{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && npm test",
    "dev": "concurrently --kill-others \"npm run dev:build\" \"npm run dev:emulators\"",
    "dev:build": "vite build --watch --mode emulator",
    "dev:emulators": "firebase emulators:start",
    "test": "firebase emulators:exec --config firebase.test.json --project demo-kit-tasks \"vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.32.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "solid-js": "^1.9.15"
  }
}
