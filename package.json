    "format:check": "elm-format src tests --validate",
    "serve": "node scripts/serve.js",
    "test": "elm-test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "elm": "^0.19.2-0",
    "elm-format": "^0.8.8",
