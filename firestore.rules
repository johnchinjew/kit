rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && validWrite();
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validWrite() {
      let data = request.resource.data;
      let oldData = resource != null ? resource.data : {};

      let operation = data.operation;

      let tasks = data.get('tasks', {});
      let repeatingTasks = data.get('repeatingTasks', {});

      let oldTasks = oldData.get('tasks', {});
      let oldRepeatingTasks = oldData.get('repeatingTasks', {});

      return operation is map
        && operation.type is string
        && tasks is map
        && repeatingTasks is map
        && oldTasks is map
        && oldRepeatingTasks is map
        && (
          (operation.type == 'CreateTask' && operation.taskId is string
            && !(operation.taskId in oldTasks) && operation.taskId in tasks
            && validTaskCreation(tasks[operation.taskId]))
          || (operation.type == 'DeleteTask' && operation.taskId is string
            && operation.taskId in oldTasks && !(operation.taskId in tasks))
          || (operation.type == 'DeleteTaskWithElapsedRetention' && operation.taskId is string
            && !(operation.taskId in tasks)
            && validTaskAutoDeletion(operation, oldTasks))
          || (operation.type in ['SetTaskTitle', 'SetTaskDetails', 'SetTaskDate', 'CompleteTask', 'ReopenTask']
            && operation.taskId is string && operation.taskId in oldTasks && operation.taskId in tasks
            && validTaskEdit(operation, tasks[operation.taskId], oldTasks[operation.taskId]))
          || (operation.type == 'CreateRepeatingTask' && operation.repeatingTaskId is string
            && !(operation.repeatingTaskId in oldRepeatingTasks) && operation.repeatingTaskId in repeatingTasks
            && validRepeatingTaskCreation(repeatingTasks[operation.repeatingTaskId]))
          || (operation.type == 'DeleteRepeatingTask' && operation.repeatingTaskId is string
            && operation.repeatingTaskId in oldRepeatingTasks && !(operation.repeatingTaskId in repeatingTasks))
          || (operation.type in ['SetRepeatingTaskTitle', 'SetRepeatingTaskDetails', 'SetRepeatingTaskSchedule']
            && operation.repeatingTaskId is string && operation.repeatingTaskId in oldRepeatingTasks && operation.repeatingTaskId in repeatingTasks
            && validRepeatingTaskEdit(operation, repeatingTasks[operation.repeatingTaskId], oldRepeatingTasks[operation.repeatingTaskId]))
          || (operation.type == 'AdvanceRepeatingTask'
            && operation.repeatingTaskId is string && operation.repeatingTaskId in oldRepeatingTasks && operation.repeatingTaskId in repeatingTasks
            && operation.createdTaskId is string && operation.createdTaskId in oldTasks
            && validRepeatingTaskAdvancement(
              operation,
              repeatingTasks[operation.repeatingTaskId],
              oldRepeatingTasks[operation.repeatingTaskId])
            )
        );
    }

    function validTaskCreation(task) {
      return task is map
        && validEditTime(task.titleEditedAt)
        && validEditTime(task.detailsEditedAt)
        && validEditTime(task.dateEditedAt)
        && validEditTime(task.completedEditedAt);
    }

    function validTaskAutoDeletion(operation, oldTasks) {
      return operation.completedAt is timestamp
        && (!(operation.taskId in oldTasks)
          || (oldTasks[operation.taskId].completed == true
            && oldTasks[operation.taskId].completedEditedAt == operation.completedAt
            && operation.completedAt <= request.time - duration.value(400, 'd')));
    }

    function validTaskEdit(operation, task, oldTask) {
      return task is map && oldTask is map && (
        (operation.type == 'SetTaskTitle' && newerEdit(task, oldTask, 'titleEditedAt'))
        || (operation.type == 'SetTaskDetails' && newerEdit(task, oldTask, 'detailsEditedAt'))
        || (operation.type == 'SetTaskDate' && newerEdit(task, oldTask, 'dateEditedAt'))
        || (operation.type == 'CompleteTask' && newerEdit(task, oldTask, 'completedEditedAt'))
        || (operation.type == 'ReopenTask' && newerEdit(task, oldTask, 'completedEditedAt'))
      );
    }

    function validRepeatingTaskCreation(repeatingTask) {
      return repeatingTask is map
        && validEditTime(repeatingTask.titleEditedAt)
        && validEditTime(repeatingTask.detailsEditedAt)
        && validEditTime(repeatingTask.scheduleEditedAt);
    }

    function validRepeatingTaskEdit(operation, repeatingTask, oldRepeatingTask) {
      return repeatingTask is map && oldRepeatingTask is map && (
        (operation.type == 'SetRepeatingTaskTitle' && newerEdit(repeatingTask, oldRepeatingTask, 'titleEditedAt'))
        || (operation.type == 'SetRepeatingTaskDetails' && newerEdit(repeatingTask, oldRepeatingTask, 'detailsEditedAt'))
        || (operation.type == 'SetRepeatingTaskSchedule' && newerEdit(repeatingTask, oldRepeatingTask, 'scheduleEditedAt'))
      );
    }

    function validRepeatingTaskAdvancement(operation, repeatingTask, oldRepeatingTask) {
      return repeatingTask is map && oldRepeatingTask is map
        && operation.scheduleEditedAt == oldRepeatingTask.scheduleEditedAt
        && repeatingTask.schedule.nextDate > oldRepeatingTask.schedule.nextDate;
    }

    function newerEdit(data, oldData, field) {
      return validEditTime(data[field])
        && data[field] > oldData.get(field, timestamp.value(0));
    }

    function validEditTime(value) {
      return value is timestamp
        && value >= timestamp.value(0)
        && value <= request.time + duration.value(5, 'm');
    }
  }
}
