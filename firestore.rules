rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && validWrite({});
      allow update: if isOwner(userId) && validWrite(resource.data);
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validWrite(oldData) {
      let data = request.resource.data;
      return data.operation is map
        && data.operation.type is string
        && validTaskWrite(data, oldData);
    }

    function validTaskWrite(data, oldData) {
      let oldTasks = oldData.get('tasks', {});
      let operationType = data.operation.type;
      let taskId = data.operation.taskId;
      return oldTasks is map
        && taskId is string
        && data.tasks is map
        && (
          (operationType == 'CreateTask'
            && !(taskId in oldTasks) && taskId in data.tasks
            && validTaskCreation(data.tasks[taskId]))
          || (operationType == 'DeleteTask'
            && taskId in oldTasks && !(taskId in data.tasks))
          || (operationType in ['SetTaskTitle', 'SetTaskDetails', 'SetTaskDate', 'CompleteTask', 'ReopenTask', 'SetTaskSchedule', 'RemoveTaskSchedule']
            && taskId in oldTasks && taskId in data.tasks
            && validTaskEdit(data.tasks[taskId], oldTasks[taskId], operationType))
          || (operationType == 'AdvanceTaskSchedule'
            && taskId in oldTasks && taskId in data.tasks
            && validScheduleAdvancement(data, oldTasks, taskId))
        );
    }

    function validScheduleAdvancement(data, oldTasks, taskId) {
      let oldTask = oldTasks[taskId];
      let op = data.operation;
      return oldTask.type == 'RepeatingTask'
        && oldTask.scheduleEditedAt == op.scheduleEditedAt
        && op.occurrenceId is string && op.occurrenceId in oldTasks
        && data.tasks[taskId].schedule.nextDate > oldTask.schedule.nextDate
        && data.tasks[taskId].type == 'RepeatingTask'
        && data.tasks[taskId].scheduleEditedAt == oldTask.scheduleEditedAt;
    }

    function validTaskCreation(task) {
      return task is map
        && task.type == 'NonRepeatingTask'
        && validEditTime(task.titleEditedAt)
        && validEditTime(task.detailsEditedAt)
        && validEditTime(task.dateEditedAt)
        && validEditTime(task.completedEditedAt);
    }

    function validTaskEdit(task, oldTask, operationType) {
      return task is map && oldTask is map && (
        (operationType == 'SetTaskSchedule' && task.type == 'RepeatingTask' && (oldTask.type == 'RepeatingTask' || oldTask.completed == false) && validScheduleEdit(task, oldTask))
        || (operationType == 'RemoveTaskSchedule' && oldTask.type == 'RepeatingTask' && task.type == 'NonRepeatingTask' && validScheduleEdit(task, oldTask))
        || (operationType == 'SetTaskTitle' && newerEdit(task, oldTask, 'titleEditedAt'))
        || (operationType == 'SetTaskDetails' && newerEdit(task, oldTask, 'detailsEditedAt'))
        || (operationType == 'SetTaskDate' && oldTask.type == 'NonRepeatingTask' && task.type == 'NonRepeatingTask' && newerEdit(task, oldTask, 'dateEditedAt'))
        || (operationType == 'CompleteTask' && oldTask.type == 'NonRepeatingTask' && newerEdit(task, oldTask, 'completedEditedAt'))
        || (operationType == 'ReopenTask' && oldTask.type == 'NonRepeatingTask' && newerEdit(task, oldTask, 'completedEditedAt'))
      );
    }

    function validScheduleEdit(task, oldTask) {
      let oldField = oldTask.type == 'RepeatingTask' ? 'scheduleEditedAt' : 'dateEditedAt';
      let newField = task.type == 'RepeatingTask' ? 'scheduleEditedAt' : 'dateEditedAt';
      return task.type in ['NonRepeatingTask', 'RepeatingTask']
        && oldTask.type in ['NonRepeatingTask', 'RepeatingTask']
        && validEditTime(task[newField])
        && task[newField] > oldTask[oldField]
        && (oldTask.type == 'RepeatingTask' || task[newField] > oldTask.completedEditedAt)
        && (task.type == 'RepeatingTask' || (task.completed == false && task.completedEditedAt == task.dateEditedAt));
    }

    function newerEdit(data, oldData, field) {
      return validEditTime(data[field])
        && data[field] > oldData[field];
    }

    function validEditTime(value) {
      return value is timestamp
        && value >= timestamp.value(0)
        && value <= request.time + duration.value(5, 'm');
    }
  }
}
